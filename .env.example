# Copia este archivo a .env en la raiz del repo y completa los valores.
# NUNCA subas el .env al repositorio (ver .gitignore).
# Generar secretos:  openssl rand -base64 48    (JWT_SECRET debe tener >= 32 bytes)
# ============================================================================
# Variables de entorno (plantilla).
# Las leen: backend (Spring Boot), ai-service (FastAPI) e infra/docker-compose.yml.
# Formato KEY=VALUE, sin espacios ni comillas; los comentarios van en su propia linea.
# Ojo: Spring lee este archivo como .properties, una barra invertida escapa el caracter
# siguiente. Evita la barra invertida en las contrasenas (o duplicala).
# Para ejecutar los servicios fuera de Docker los hosts apuntan a localhost;
# docker-compose sobreescribe los hosts con los nombres de servicio (postgres, redis, rabbitmq, ai-service).
# ============================================================================

# ---- Base de datos (PostgreSQL) ----
# DB_NAME lo usa docker-compose para crear la base; DB_URL lo usa el backend.
DB_NAME=diagramas
# Los puertos publicados por docker-compose estan desplazados para no chocar con otros
# PostgreSQL/Redis que ya corran en la maquina.
DB_PORT=15432
DB_URL=jdbc:postgresql://localhost:15432/diagramas
DB_USER=diagramas
DB_PASSWORD=

# ---- Seguridad ----
# JWT_SECRET: mínimo 32 bytes
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
# Contrasena del SOFTWARE_ADMIN inicial (usuario admin, empresa platform). En perfil dev también la usan los usuarios demo.
SEED_ADMIN_PASSWORD=

# ---- RabbitMQ (STOMP broker relay) ----
RABBIT_HOST=localhost
RABBIT_STOMP_PORT=61613
RABBIT_USER=diagramas
RABBIT_PASSWORD=

# ---- Redis (participantes activos y locks por elemento) ----
REDIS_HOST=localhost
REDIS_PORT=16379

# ---- Colaboración en tiempo real ----
# true = Redis + RabbitMQ (multi-instancia). false = en memoria, un solo nodo (no requiere Redis ni RabbitMQ).
COLLAB_DISTRIBUTED=true

# ---- ai-service (Copilot IA) ----
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=
AI_TIMEOUT_SECONDS=30
# openai | local
LLM_PROVIDER=openai
# COMPLETAR: clave del proveedor y nombre del modelo (no se fija ningun modelo en el codigo)
LLM_API_KEY=
LLM_MODEL=
# --- Ejemplo con Gemini (Google AI Studio) ---
# LLM_PROVIDER=openai                      (es el "cliente compatible con OpenAI"; no significa que uses OpenAI)
# LLM_API_KEY=AIza...                      (clave de https://aistudio.google.com/apikey)
# LLM_MODEL=<nombre del modelo Gemini>
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Vacio = URL por defecto del proveedor (openai: https://api.openai.com/v1, local: http://localhost:11434/v1)
LLM_BASE_URL=
# Debe ser menor que AI_TIMEOUT_SECONDS para que el backend reciba un 504 controlado
LLM_TIMEOUT_SECONDS=25

# ---- Firebase Cloud Messaging (push) ----
# Ruta al JSON de credenciales (archivo montado, no en el repo). Vacio = push deshabilitado
FCM_CREDENTIALS_PATH=

# ---- Archivos (AWS S3) ----
# S3_BUCKET vacio = se guardan en disco local (./data/storage). S3_ENDPOINT solo para MinIO/LocalStack
S3_BUCKET=
AWS_REGION=us-east-1
S3_ENDPOINT=

# ---- CORS ----
# El 4200 es el servidor de desarrollo de Vite; el 8081 es la SPA servida por Nginx.
# El navegador envia la cabecera Origin tambien en peticiones del mismo origen, asi que el 8081
# tiene que estar en la lista o el backend responde 403.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081